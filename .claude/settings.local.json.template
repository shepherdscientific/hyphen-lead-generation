  "// ============================================": "",
  "// NOTES": "",
  "// ============================================": "",

  "// Pattern Syntax": "",
  "// - **        matches any directory depth": "",
  "// - *         matches any characters in filename": "",
  "// - {a,b,c}   matches any of a, b, or c": "",

  "// Examples": "",
  "// \"Read(**/*.ts)\"           - Read all TypeScript files": "",
  "// \"Edit(src/**/*.py)\"       - Edit Python files in src/": "",
  "// \"Bash(npm run test:*)\"   - Run any npm test command": "",

  "// Safety Tips": "",
  "// 1. Start with Level 1, gradually increase": "",
  "// 2. Use 'deny' to explicitly block dangerous operations": "",
  "// 3. Always deny .env files and secrets": "",
  "// 4. Test in a development branch first": "",
  "// 5. Review git diffs after autonomous runs": "",

